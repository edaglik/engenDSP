				"box" : 				{
					"code" : "History s1(0), s2(0); // Capacitors\r\n\r\n// Input/param assignments\r\ninput = in1;\r\ncutoff = in2;\r\nR = 1 - in3;\r\n\r\n// Variables\r\ng = tan(pi*cutoff/samplerate);\r\ng1 = 2*R + g;\r\nd = 1/(1 + 2*R*g + g*g);\r\n\r\nhp = (input - g1*s1 - s2) * d; //highpass\r\n\r\nv1 = g*hp;\r\nbp = v1 + s1; //bandpass\r\ns1 = bp + v1; //update s1\r\n\r\nv2 = g*bp;\r\nlp = v2 + s2; //lowpass\r\ns2 = lp + v2; //update s2\r\n\r\nout1, out2, out3 = lp, hp, bp;",
					"fontface" : 0,
