		"boxes" : [ 			{
				"box" : 				{
					"code" : "//this code implements a dynamic smoothing filter \r\n//based on an algorithm by Andrew Simper.\r\n//It uses a lowpass filter whose cutoff frequency is modulated dynamically \r\n//by the signal itself and allows to track signal changes faster than a purely\r\n//static version.\n\n//The main use of this crate is to smooth noisy or stepped signals \r\n//like analog measurements from an ADC in embedded systems.\n\n\r\n\r\nParam basefreq(2); // fine tune to suit your application\r\nParam sensitivity(2); // fine tune to suit your application\r\n//clear the history\r\nHistory low1(0);\r\nHistory low2(0);\r\nHistory inz(0); \r\n\r\nwc = basefreq/samplerate; // cubic cutoff mapping done inside the algorithm\r\n\r\nlow1z = low1; \r\nlow2z = low2;\r\nbandz = low1z - low2z;\r\nwd = wc + sensitivity*abs(bandz);\r\ng = min(wd*(5.9948827 + wd*(-11.969296 + wd*15.959062)), 1);\r\nlow1 = low1z + g*(0.5*(in1 + inz) - low1z);\r\nlow2 = low2z + g*(0.5*(low1 + low1z) - low2z);\r\ninz = in1;\r\nout1 = low2;\r\n",
					"fontface" : 0,
					"fontname" : "<Monospaced>",
					"fontsize" : 12.0,
					"id" : "obj-5",
					"maxclass" : "codebox",
					"numinlets" : 1,
					"numoutlets" : 1,
					"outlettype" : [ "" ],
					"patching_rect" : [ 31.0, 48.0, 638.0, 473.0 ]
				}

			}
, 			{
